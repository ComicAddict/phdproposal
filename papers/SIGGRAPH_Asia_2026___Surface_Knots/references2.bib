% References on knots, knotted surfaces, and dimensional dependence of knotting
%
% These citations support the following standard facts:
% (1) All 1D knots become unknotted in four-dimensional space.
% (2) Nontrivial knotted surfaces (2-manifolds) exist in four dimensions.
% (3) In sufficiently high ambient dimensions, knotting and chirality
%     distinctions disappear, explaining why integer twist is not encoded
%     in higher-dimensional topological frameworks.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

@book{freedman1990topology,
  author    = {Freedman, Michael H. and Quinn, Frank},
  title     = {Topology of 4-Manifolds},
  publisher = {Princeton University Press},
  address   = {Princeton, New Jersey, USA},
  year      = {1990}
}

  % Supports:
  % - Any classical (1D) knot becomes unknotted when embedded in 4D.
  % - Explains why many 3D knot invariants vanish in four dimensions.


@book{kamada2002surfaces,
  author    = {Kamada, Seiichi},
  title     = {Surfaces in 4-Space},
  publisher = {Springer},
  address   = {Berlin, Germany},
  year      = {2002}
}
  % Supports:
  % - Existence of nontrivial knotted surfaces (2-manifolds) in 4D.
  % - Surface knot theory, including isotopy classes and invariants.




