@article{grunbaum1988catalogue,
title = {An extension to the catalogue of isonemal fabrics},
journal = {Discrete Mathematics},
volume = {60},
pages = {155-192},
year = {1986},
issn = {0012-365X},
doi = {https://doi.org/10.1016/0012-365X(86)90010-5},
url = {https://www.sciencedirect.com/science/article/pii/0012365X86900105},
author = {Branko Grünbaum and G.C. Shephard},
abstract = {A fabric consists of two interwoven parallel sets of equally-space strands, the sets being at right angles to each other and “hanging together”. A fabric is isonemal if the strands form one transitivity class under symmetries of the fabric. Except in very simple cases the enumeration of isonemal fabrics of a given period appears to be intractable by theoretical means. The purpose of this paper is to extend earlier results; computer techniques are used to enumerate isonemal fabrics of periods up to 20, and those of periods 10, 12, 15 and 17 are illustrated. Some general results about isonemal fabrics are also established.}
}

